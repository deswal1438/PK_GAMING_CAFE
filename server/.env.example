MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pk-gaming-cafe
PORT=8787
PUBLIC_ORIGIN=https://pk-gaming-cafe.oakislet64.chatgpt.site
ADMIN_API_KEY=replace-with-a-long-random-secret
ENABLE_ONE_RUPEE_DEMO=false

# UAT: https://pluraluat.v2.pinepg.in
# Production: use the exact base URL supplied in your Pine Labs onboarding pack.
PINE_LABS_BASE_URL=https://pluraluat.v2.pinepg.in
PINE_LABS_CLIENT_ID=replace-with-pine-labs-client-id
PINE_LABS_CLIENT_SECRET=replace-with-pine-labs-client-secret

# Base64-encoded webhook signing secret from Pine Labs Settings > Webhook.
PINE_LABS_WEBHOOK_SECRET=replace-with-base64-webhook-secret
PINE_LABS_WEBHOOK_TOLERANCE_SECONDS=300

# Pine Labs redirects the customer here after checkout.
PINE_LABS_CALLBACK_URL=https://pk-gaming-cafe.oakislet64.chatgpt.site/?payment=return
